<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle %> • Campus Micro Job Portal</title>

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#eef2ff',
              100: '#e0e7ff',
              500: '#6366f1',
              600: '#4f46e5',
              700: '#4338ca',
              dark: '#0F1117',
              card: '#161B22',
              border: '#1F2633'
            }
          },
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'DM Sans', 'sans-serif'],
            heading: ['Outfit', 'Syne', 'sans-serif']
          }
        }
      }
    }
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <link rel="stylesheet" href="/css/output.css" />

  <style>
    :root {
      --bg-gradient: radial-gradient(circle at 50% -20%, rgba(99, 102, 241, 0.15), transparent 70%);
    }

    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
    }
    .font-heading {
      font-family: 'Outfit', sans-serif;
    }

    /* Subtle Grid Pattern Overlay */
    .grid-bg-overlay {
      background-image: 
        linear-gradient(to right, rgba(99, 102, 241, 0.04) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(99, 102, 241, 0.04) 1px, transparent 1px);
      background-size: 36px 36px;
    }
    .dark .grid-bg-overlay {
      background-image: 
        linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    }

    /* Gradient Text Highlight */
    .text-gradient-purple {
      background: linear-gradient(135deg, #6366f1 0%, #3b82f6 50%, #8b5cf6 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    /* Soft Elevated Cards */
    .saas-card {
      background-color: #ffffff;
      border: 1px solid #f1f5f9;
      box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.04);
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .dark .saas-card {
      background-color: #161B22;
      border-color: #1F2633;
      box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.2);
    }
    .saas-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 20px 30px -10px rgba(99, 102, 241, 0.12);
      border-color: rgba(99, 102, 241, 0.3);
    }

    /* Category Cards Lift */
    .cat-card {
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .cat-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 16px 32px -8px rgba(99, 102, 241, 0.2);
      border-color: #6366f1;
    }

    /* Pill Filter Styling */
    .filter-tab {
      padding: 8px 18px;
      border-radius: 9999px;
      font-size: 0.82rem;
      font-weight: 600;
      white-space: nowrap;
      transition: all 0.2s ease;
      cursor: pointer;
      border: 1px solid #e2e8f0;
      background-color: #ffffff;
      color: #64748b;
    }
    .dark .filter-tab {
      border-color: #1F2633;
      background-color: #161B22;
      color: #94a3b8;
    }
    .filter-tab:hover {
      border-color: #6366f1;
      color: #6366f1;
    }
    .filter-tab.active {
      background: linear-gradient(135deg, #4f46e5 0%, #3b82f6 100%);
      color: #ffffff;
      border-color: transparent;
      box-shadow: 0 4px 14px rgba(79, 70, 229, 0.3);
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: transparent;
    }
    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 10px;
    }
    .dark ::-webkit-scrollbar-thumb {
      background: #334155;
    }
  </style>
</head>

<body class="bg-slate-50 dark:bg-[#0F1117] text-slate-800 dark:text-slate-200 min-h-screen relative selection:bg-indigo-500 selection:text-white transition-colors duration-300">

  <!-- Background Ambient Glow & Grid -->
  <div class="fixed inset-0 grid-bg-overlay pointer-events-none z-0"></div>
  <div class="fixed top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-[500px] pointer-events-none z-0 opacity-40 dark:opacity-20 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-indigo-400 via-blue-200 to-transparent blur-3xl"></div>

  <!-- NAVBAR HEADER -->
  <%- include('../partials/header', { isLoggedIn: isLoggedIn, user: user }) %>

  <!-- MAIN CONTENT CONTAINER -->
  <main class="relative z-10 pt-28 pb-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- ================================================== -->
    <!-- 1. HERO SECTION -->
    <!-- ================================================== -->
    <section class="text-center pt-6 pb-12 sm:pb-16 max-w-4xl mx-auto">
      
      <!-- Eyebrow Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-indigo-50 dark:bg-indigo-950/60 border border-indigo-200/80 dark:border-indigo-800/60 shadow-sm mb-6 animate-pulse">
        <span class="w-2 h-2 rounded-full bg-indigo-600 dark:bg-indigo-400"></span>
        <span class="text-xs font-bold tracking-wide text-indigo-700 dark:text-indigo-300 uppercase">
          Parul University Campus Network
        </span>
      </div>

      <!-- Main Heading -->
      <h1 class="font-heading text-4xl sm:text-6xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-[1.15] sm:leading-[1.12]">
        Find <span class="text-gradient-purple">Opportunities.</span><br />
        Build <span class="text-gradient-purple">Skills.</span><br />
        Earn on <span class="text-gradient-purple">Campus.</span>
      </h1>

      <!-- Supporting Text -->
      <p class="mt-6 text-base sm:text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto leading-relaxed">
        Discover micro-jobs, build professional experience, and earn money while studying. Verified tasks hosted directly inside your university campus.
      </p>

      <!-- Search Bar -->
      <div class="mt-8 max-w-2xl mx-auto relative group">
        <div class="relative flex items-center bg-white dark:bg-[#161B22] border border-slate-200 dark:border-slate-800 rounded-2xl shadow-xl shadow-indigo-500/5 focus-within:border-indigo-500 dark:focus-within:border-indigo-500 focus-within:ring-4 focus-within:ring-indigo-500/10 transition-all p-2">
          <i class="fa-solid fa-magnifying-glass text-slate-400 dark:text-slate-500 text-lg ml-4 mr-3"></i>
          <input
            type="text"
            id="task-search-input"
            onkeyup="filterTasks()"
            placeholder="Search tasks, skills, or categories..."
            class="w-full bg-transparent text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none text-sm font-medium pr-2"
          />
          <button type="button" onclick="filterTasks()" class="px-5 py-3 rounded-xl bg-gradient-to-r from-indigo-600 to-blue-600 hover:from-indigo-500 hover:to-blue-500 text-white font-heading font-bold text-xs uppercase tracking-wider shadow-md hover:shadow-lg transition-all flex items-center gap-2 flex-shrink-0">
            <span>Search</span>
            <i class="fa-solid fa-arrow-right text-xs"></i>
          </button>
        </div>
      </div>

      <!-- Popular Category Quick Pills -->
      <div class="mt-4 flex items-center justify-center gap-2 flex-wrap text-xs text-slate-500 dark:text-slate-400 font-medium">
        <span class="font-bold text-slate-400 uppercase tracking-wider text-[10px]">Popular:</span>
        <button onclick="quickSearch('Coding')" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">Coding</button>
        <span>•</span>
        <button onclick="quickSearch('Design')" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">Design</button>
        <span>•</span>
        <button onclick="quickSearch('Tutoring')" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">Tutoring</button>
        <span>•</span>
        <button onclick="quickSearch('Delivery')" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">Delivery</button>
        <span>•</span>
        <button onclick="quickSearch('Events')" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">Events</button>
        <span>•</span>
        <button onclick="quickSearch('Photography')" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">Photography</button>
      </div>

      <!-- CTA Buttons -->
      <div class="mt-8 flex items-center justify-center gap-4 flex-wrap">
        <a href="#live-tasks" class="px-7 py-3.5 rounded-2xl bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-heading font-bold text-sm hover:bg-indigo-600 dark:hover:bg-indigo-400 dark:hover:text-white transition-all shadow-lg hover:shadow-indigo-500/25 hover:-translate-y-0.5 flex items-center gap-2">
          <span>Explore Tasks</span>
          <i class="fa-solid fa-arrow-down text-xs"></i>
        </a>
        <a href="#how-it-works" class="px-7 py-3.5 rounded-2xl bg-white dark:bg-[#161B22] border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-200 font-heading font-semibold text-sm hover:border-indigo-400 dark:hover:border-indigo-500 transition-all hover:-translate-y-0.5 shadow-sm">
          How It Works
        </a>
      </div>

    </section>


    <!-- ================================================== -->
    <!-- 2. STATISTICS SECTION -->
    <!-- ================================================== -->
    <section class="py-6 mb-16 grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">

      <div class="saas-card rounded-3xl p-6 text-center group">
        <div class="w-12 h-12 rounded-2xl bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 flex items-center justify-center mx-auto mb-3 text-xl group-hover:scale-110 transition-transform">
          <i class="fa-solid fa-bolt"></i>
        </div>
        <div class="font-heading text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">100+</div>
        <div class="text-xs font-bold uppercase tracking-wider text-slate-400 mt-1">Active Tasks</div>
        <div class="mt-2 inline-flex items-center gap-1 text-[11px] font-semibold text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/50 px-2.5 py-0.5 rounded-full">
          <i class="fa-solid fa-arrow-trend-up"></i> +14% this week
        </div>
      </div>

      <div class="saas-card rounded-3xl p-6 text-center group">
        <div class="w-12 h-12 rounded-2xl bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center mx-auto mb-3 text-xl group-hover:scale-110 transition-transform">
          <i class="fa-solid fa-indian-rupee-sign"></i>
        </div>
        <div class="font-heading text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">₹10K+</div>
        <div class="text-xs font-bold uppercase tracking-wider text-slate-400 mt-1">Student Earnings</div>
        <div class="mt-2 inline-flex items-center gap-1 text-[11px] font-semibold text-slate-500 dark:text-slate-400 bg-slate-100 dark:bg-slate-800 px-2.5 py-0.5 rounded-full">
          Total Paid Out
        </div>
      </div>

      <div class="saas-card rounded-3xl p-6 text-center group">
        <div class="w-12 h-12 rounded-2xl bg-amber-50 dark:bg-amber-950/60 text-amber-500 flex items-center justify-center mx-auto mb-3 text-xl group-hover:scale-110 transition-transform">
          <i class="fa-solid fa-star"></i>
        </div>
        <div class="font-heading text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">4.9★</div>
        <div class="text-xs font-bold uppercase tracking-wider text-slate-400 mt-1">Community Rating</div>
        <div class="mt-2 inline-flex items-center gap-1 text-[11px] font-semibold text-amber-600 dark:text-amber-400 bg-amber-50 dark:bg-amber-950/50 px-2.5 py-0.5 rounded-full">
          500+ Verified Reviews
        </div>
      </div>

      <div class="saas-card rounded-3xl p-6 text-center group">
        <div class="w-12 h-12 rounded-2xl bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 flex items-center justify-center mx-auto mb-3 text-xl group-hover:scale-110 transition-transform">
          <i class="fa-solid fa-shield-check"></i>
        </div>
        <div class="font-heading text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">98%</div>
        <div class="text-xs font-bold uppercase tracking-wider text-slate-400 mt-1">Completion Rate</div>
        <div class="mt-2 inline-flex items-center gap-1 text-[11px] font-semibold text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-950/50 px-2.5 py-0.5 rounded-full">
          Verified Hosts & Students
        </div>
      </div>

    </section>


    <!-- ================================================== -->
    <!-- 3. CATEGORY SECTION -->
    <!-- ================================================== -->
    <section class="py-8 mb-16">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h2 class="font-heading text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
            Explore Categories
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
            Browse campus micro-jobs by your domain of expertise.
          </p>
        </div>
      </div>

      <!-- Categories Grid (8 Cards) -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        
        <div onclick="filterByCategory('Coding')" class="cat-card saas-card rounded-3xl p-5 cursor-pointer bg-white dark:bg-[#161B22] border border-slate-200/80 dark:border-slate-800 flex flex-col justify-between h-36 group">
          <div class="flex items-center justify-between">
            <div class="w-10 h-10 rounded-2xl bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 flex items-center justify-center text-xl group-hover:scale-110 transition-transform">
              💻
            </div>
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest bg-slate-100 dark:bg-slate-800 px-2 py-0.5 rounded-full">24 Tasks</span>
          </div>
          <div>
            <h3 class="font-heading font-bold text-base text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">Coding & Tech</h3>
            <p class="text-[11px] text-slate-400 mt-0.5">Bug fixes, web dev, scripts</p>
          </div>
        </div>

        <div onclick="filterByCategory('Design')" class="cat-card saas-card rounded-3xl p-5 cursor-pointer bg-white dark:bg-[#161B22] border border-slate-200/80 dark:border-slate-800 flex flex-col justify-between h-36 group">
          <div class="flex items-center justify-between">
            <div class="w-10 h-10 rounded-2xl bg-purple-50 dark:bg-purple-950/60 text-purple-600 dark:text-purple-400 flex items-center justify-center text-xl group-hover:scale-110 transition-transform">
              🎨
            </div>
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest bg-slate-100 dark:bg-slate-800 px-2 py-0.5 rounded-full">18 Tasks</span>
          </div>
          <div>
            <h3 class="font-heading font-bold text-base text-slate-900 dark:text-white group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors">Design & Media</h3>
            <p class="text-[11px] text-slate-400 mt-0.5">Posters, UI, branding</p>
          </div>
        </div>

        <div onclick="filterByCategory('Tutoring')" class="cat-card saas-card rounded-3xl p-5 cursor-pointer bg-white dark:bg-[#161B22] border border-slate-200/80 dark:border-slate-800 flex flex-col justify-between h-36 group">
          <div class="flex items-center justify-between">
            <div class="w-10 h-10 rounded-2xl bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-xl group-hover:scale-110 transition-transform">
              📚
            </div>
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest bg-slate-100 dark:bg-slate-800 px-2 py-0.5 rounded-full">15 Tasks</span>
          </div>
          <div>
            <h3 class="font-heading font-bold text-base text-slate-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">Tutoring & Prep</h3>
            <p class="text-[11px] text-slate-400 mt-0.5">Maths, coding, exam prep</p>
          </div>
        </div>

        <div onclick="filterByCategory('Delivery')" class="cat-card saas-card rounded-3xl p-5 cursor-pointer bg-white dark:bg-[#161B22] border border-slate-200/80 dark:border-slate-800 flex flex-col justify-between h-36 group">
          <div class="flex items-center justify-between">
            <div class="w-10 h-10 rounded-2xl bg-amber-50 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 flex items-center justify-center text-xl group-hover:scale-110 transition-transform">
              📦
            </div>
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest bg-slate-100 dark:bg-slate-800 px-2 py-0.5 rounded-full">32 Tasks</span>
          </div>
          <div>
            <h3 class="font-heading font-bold text-base text-slate-900 dark:text-white group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors">Campus Delivery</h3>
            <p class="text-[11px] text-slate-400 mt-0.5">Notes, food, hostel errands</p>
          </div>
        </div>

        <div onclick="filterByCategory('Photography')" class="cat-card saas-card rounded-3xl p-5 cursor-pointer bg-white dark:bg-[#161B22] border border-slate-200/80 dark:border-slate-800 flex flex-col justify-between h-36 group">
          <div class="flex items-center justify-between">
            <div class="w-10 h-10 rounded-2xl bg-rose-50 dark:bg-rose-950/60 text-rose-600 dark:text-rose-400 flex items-center justify-center text-xl group-hover:scale-110 transition-transform">
              📸
            </div>
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest bg-slate-100 dark:bg-slate-800 px-2 py-0.5 rounded-full">12 Tasks</span>
          </div>
          <div>
            <h3 class="font-heading font-bold text-base text-slate-900 dark:text-white group-hover:text-rose-600 dark:group-hover:text-rose-400 transition-colors">Photography</h3>
            <p class="text-[11px] text-slate-400 mt-0.5">Portraits, fest coverage</p>
          </div>
        </div>

        <div onclick="filterByCategory('Events')" class="cat-card saas-card rounded-3xl p-5 cursor-pointer bg-white dark:bg-[#161B22] border border-slate-200/80 dark:border-slate-800 flex flex-col justify-between h-36 group">
          <div class="flex items-center justify-between">
            <div class="w-10 h-10 rounded-2xl bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 flex items-center justify-center text-xl group-hover:scale-110 transition-transform">
              🎉
            </div>
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest bg-slate-100 dark:bg-slate-800 px-2 py-0.5 rounded-full">10 Tasks</span>
          </div>
          <div>
            <h3 class="font-heading font-bold text-base text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">Event Support</h3>
            <p class="text-[11px] text-slate-400 mt-0.5">Stage crew, registration</p>
          </div>
        </div>

        <div onclick="filterByCategory('Writing')" class="cat-card saas-card rounded-3xl p-5 cursor-pointer bg-white dark:bg-[#161B22] border border-slate-200/80 dark:border-slate-800 flex flex-col justify-between h-36 group">
          <div class="flex items-center justify-between">
            <div class="w-10 h-10 rounded-2xl bg-teal-50 dark:bg-teal-950/60 text-teal-600 dark:text-teal-400 flex items-center justify-center text-xl group-hover:scale-110 transition-transform">
              ✍️
            </div>
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest bg-slate-100 dark:bg-slate-800 px-2 py-0.5 rounded-full">14 Tasks</span>
          </div>
          <div>
            <h3 class="font-heading font-bold text-base text-slate-900 dark:text-white group-hover:text-teal-600 dark:group-hover:text-teal-400 transition-colors">Writing & Proofing</h3>
            <p class="text-[11px] text-slate-400 mt-0.5">Reports, typing, editing</p>
          </div>
        </div>

        <div onclick="filterByCategory('Marketing')" class="cat-card saas-card rounded-3xl p-5 cursor-pointer bg-white dark:bg-[#161B22] border border-slate-200/80 dark:border-slate-800 flex flex-col justify-between h-36 group">
          <div class="flex items-center justify-between">
            <div class="w-10 h-10 rounded-2xl bg-orange-50 dark:bg-orange-950/60 text-orange-600 dark:text-orange-400 flex items-center justify-center text-xl group-hover:scale-110 transition-transform">
              📱
            </div>
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest bg-slate-100 dark:bg-slate-800 px-2 py-0.5 rounded-full">9 Tasks</span>
          </div>
          <div>
            <h3 class="font-heading font-bold text-base text-slate-900 dark:text-white group-hover:text-orange-600 dark:group-hover:text-orange-400 transition-colors">Marketing</h3>
            <p class="text-[11px] text-slate-400 mt-0.5">Social media, promotion</p>
          </div>
        </div>

      </div>
    </section>


    <!-- ================================================== -->
    <!-- 4. RECOMMENDED TASKS SECTION -->
    <!-- ================================================== -->
    <section class="py-8 mb-16">
      <div class="flex items-center justify-between mb-6">
        <div>
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-indigo-600"></span>
            <h2 class="font-heading text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
              Recommended For You
            </h2>
          </div>
          <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
            Tasks matched with your skills and interests.
          </p>
        </div>
        <a href="#live-tasks" class="text-xs font-bold text-indigo-600 dark:text-indigo-400 hover:underline flex items-center gap-1">
          View All <i class="fa-solid fa-chevron-right text-[10px]"></i>
        </a>
      </div>

      <!-- Horizontal Cards Carousel Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

        <!-- Card 1 -->
        <div class="saas-card rounded-3xl p-6 flex flex-col justify-between group relative overflow-hidden">
          <div>
            <div class="flex items-center justify-between mb-3">
