  <!-- CLIENT-SIDE SEARCH & FILTER JS ENGINE -->
  <script>
    let activeCategory = 'All';

    function quickSearch(query) {
      const input = document.getElementById('task-search-input');
      if (input) {
        input.value = query;
        filterTasks();
        input.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }

    function setCategoryFilter(category, btn) {
      activeCategory = category;
      document.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('active'));
      if (btn) btn.classList.add('active');
      const catSelect = document.getElementById('filter-category');
      if (catSelect) catSelect.value = category === 'All' ? 'All' : category;
      filterTasks();
    }

    function filterByCategory(cat) {
      quickSearch(cat);
    }

    function filterTasks() {
      const searchVal = (document.getElementById('task-search-input')?.value || '').toLowerCase().trim();
      const catVal = (document.getElementById('filter-category')?.value || 'All').toLowerCase();
      const payVal = document.getElementById('filter-payment')?.value || 'All';
      const locVal = (document.getElementById('filter-location')?.value || 'All').toLowerCase();

      const cards = document.querySelectorAll('.task-item-card');

      cards.forEach(card => {
        const title = card.getAttribute('data-title') || '';
        const type = card.getAttribute('data-type') || '';
        const location = card.getAttribute('data-location') || '';
        const price = parseFloat(card.getAttribute('data-price') || 0);

        let matchesSearch = !searchVal || title.includes(searchVal) || type.includes(searchVal) || location.includes(searchVal);
        let matchesCat = (catVal === 'all') || type.includes(catVal);
        
        let matchesPay = true;
        if (payVal === 'under300') matchesPay = price < 300;
        else if (payVal === '300to1000') matchesPay = price >= 300 && price <= 1000;
        else if (payVal === 'above1000') matchesPay = price > 1000;

        let matchesLoc = true;
        if (locVal !== 'all') {
          matchesLoc = location.includes(locVal);
        }

        if (matchesSearch && matchesCat && matchesPay && matchesLoc) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    }

    function sortTasks() {
      const sortVal = document.getElementById('sort-select')?.value;
      const container = document.getElementById('tasks-grid-container');
      if (!container) return;

      const cards = Array.from(container.children);
      cards.sort((a, b) => {
        const priceA = parseFloat(a.getAttribute('data-price') || 0);
        const priceB = parseFloat(b.getAttribute('data-price') || 0);
        const ratingA = parseFloat(a.getAttribute('data-rating') || 0);
        const ratingB = parseFloat(b.getAttribute('data-rating') || 0);

        if (sortVal === 'price-high') return priceB - priceA;
        if (sortVal === 'price-low') return priceA - priceB;
        if (sortVal === 'rating') return ratingB - ratingA;
        return 0; // recommended default
      });

      cards.forEach(card => container.appendChild(card));
    }

    async function toggleBookmark(btn, taskId) {
      if (!taskId) return;
      const icon = btn.querySelector('i');
      const isCurrentlySaved = icon && icon.classList.contains('fa-solid');
      const endpoint = isCurrentlySaved ? `/favourites/delete/${taskId}` : '/favourites';

      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({ id: taskId })
        });

        if (res.status === 401) {
          window.location.href = '/login';
          return;
        }

        const data = await res.json();
        if (data.success) {
          if (data.isSaved) {
            if (icon) {
              icon.className = 'fa-solid fa-bookmark text-rose-500 text-xs';
            }
            btn.setAttribute('title', 'Remove from Saved');
          } else {
            if (icon) {
              icon.className = 'fa-regular fa-bookmark text-xs';
            }
            btn.setAttribute('title', 'Save Task');
          }
        }
      } catch (err) {
        console.error('Error toggling bookmark:', err);
      }
    }

  </script>

