<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <style>body { font-family: 'Plus Jakarta Sans', sans-serif; background: #0f172a; color: #f8fafc; }</style>
</head>
<body class="min-h-screen flex items-center justify-center p-6">
  <div class="max-w-md w-full text-center bg-slate-900 border border-slate-800 p-8 rounded-3xl shadow-2xl">
    
    <% if (status === 'rejected') { %>
      <div class="w-16 h-16 bg-rose-500/20 text-rose-400 rounded-2xl flex items-center justify-center text-3xl mx-auto mb-5">
        <i class="fa-solid fa-circle-xmark"></i>
      </div>
      <h2 class="text-2xl font-bold text-white mb-2">Student Verification Rejected</h2>
      <p class="text-slate-400 text-sm mb-4 leading-relaxed">
        Your Parul University student verification request was not approved.
      </p>
      <% if (rejectionReason) { %>
      <div class="bg-rose-950/40 border border-rose-900 p-3 rounded-xl text-left text-xs text-rose-300 mb-6">
        <strong>Reason:</strong> <%= rejectionReason %>
      </div>
      <% } %>
    <% } else { %>
      <div class="w-16 h-16 bg-indigo-500/20 text-indigo-400 rounded-2xl flex items-center justify-center text-3xl mx-auto mb-5">
        <i class="fa-solid fa-user-clock"></i>
      </div>
      <h2 class="text-2xl font-bold text-white mb-2">Verification Under Review</h2>
      <p class="text-slate-400 text-sm mb-6 leading-relaxed">
        Your student profile is currently being verified by **Parul University Admin**.
        You will be able to apply for jobs as soon as your account is verified.
      </p>
    <% } %>

    <div class="flex gap-3">
      <a href="/" class="flex-1 bg-slate-800 hover:bg-slate-700 text-white font-bold py-3 rounded-xl text-xs transition">
        Browse Jobs
      </a>
      <a href="/complete-profile" class="flex-1 bg-indigo-600 hover:bg-indigo-500 text-white font-bold py-3 rounded-xl text-xs transition">
        Update Details
      </a>
    </div>
  </div>
</body>
</html>
