  <script>
    function toggleRoleFields() {
      const isStudent = document.getElementById('role-student').checked;
      const studentFields = document.getElementById('student-fields');
      const hostFields = document.getElementById('host-fields');
      
      const studentInputs = studentFields.querySelectorAll('input, select');
      const hostInputs = hostFields.querySelectorAll('input, select, textarea');

      if (isStudent) {
        studentFields.classList.remove('hidden');
        hostFields.classList.add('hidden');
        studentInputs.forEach(i => { if (i.name !== 'division' && i.name !== 'resume') i.required = true; });
        hostInputs.forEach(i => i.required = false);
      } else {
        studentFields.classList.add('hidden');
        hostFields.classList.remove('hidden');
        studentInputs.forEach(i => i.required = false);
        document.getElementById('organization').required = true;
        document.getElementById('hostCampusLocation').required = true;
        document.getElementById('universityAffiliation').required = true;
        document.getElementById('contactInfo').required = true;
      }
    }
    toggleRoleFields();
  </script>
