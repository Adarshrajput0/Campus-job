<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background: #0f172a; color: #f8fafc; }
    .font-heading { font-family: 'Outfit', sans-serif; }

    .role-card input[type="radio"] { display: none; }
    .role-card .card-inner {
      border: 2px solid #334155;
      border-radius: 24px;
      padding: 24px 20px;
      text-align: center;
      cursor: pointer;
      transition: all 0.25s ease;
      background: #1e293b;
      position: relative;
    }
    .role-card input[type="radio"]:checked + .card-inner {
      border-color: #6366f1;
      box-shadow: 0 0 0 4px rgba(99,102,241,0.25);
      background: #1e1b4b;
    }

    .icon-wrap {
      width: 56px; height: 56px;
      border-radius: 16px;
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 12px;
      font-size: 24px;
    }
    .student-icon { background: rgba(99, 102, 241, 0.2); color: #818cf8; }
    .host-icon    { background: rgba(16, 185, 129, 0.2); color: #34d399; }

    .input-field {
      width: 100%;
      background: #0f172a;
      border: 1px solid #334155;
      border-radius: 12px;
      padding: 10px 14px;
      color: #f8fafc;
      font-size: 14px;
      outline: none;
      transition: border 0.2s;
    }
    .input-field:focus {
      border-color: #6366f1;
    }
    optgroup {
      background: #1e293b;
      color: #818cf8;
      font-weight: bold;
    }
    option {
      background: #0f172a;
      color: #f8fafc;
    }
  </style>
</head>
<body class="min-h-screen flex items-center justify-center p-6">

  <div class="max-w-2xl w-full my-8">

    <!-- Header -->
    <div class="text-center mb-8">
      <div class="inline-flex items-center gap-2 bg-indigo-950/80 border border-indigo-500/30 px-4 py-1.5 rounded-full text-xs font-semibold text-indigo-300 mb-3">
        <span class="w-2 h-2 rounded-full bg-indigo-400 animate-pulse"></span>
        Parul University Campus Micro Job MIS
      </div>
      <h1 class="font-heading text-3xl font-extrabold tracking-tight">
        Complete Your Registration 🎓
      </h1>
      <p class="text-slate-400 mt-2 text-sm">
        Choose your role and provide your details to get started. Parul University emails get auto-verified!
      </p>
    </div>

    <!-- Errors -->
    <% if (errors && errors.length > 0) { %>
    <div class="mb-6 p-4 bg-rose-950/60 border border-rose-500/50 rounded-xl text-rose-300 text-xs font-bold">
      <i class="fa-solid fa-triangle-exclamation mr-2"></i> <%= errors[0] %>
    </div>
    <% } %>

    <form action="/complete-profile" method="POST" class="space-y-6">
      
      <!-- Role Selection -->
      <div>
        <label class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-3">Select Account Type</label>
        <div class="grid grid-cols-2 gap-4">
          <label class="role-card">
            <input type="radio" name="userType" value="student" id="role-student" checked onchange="toggleRoleFields()">
            <div class="card-inner">
              <div class="icon-wrap student-icon">
                <i class="fa-solid fa-user-graduate"></i>
              </div>
              <h3 class="font-heading text-base font-bold text-white">Student</h3>
              <p class="text-xs text-slate-400 mt-1">Apply for campus jobs & build portfolio</p>
            </div>
          </label>

          <label class="role-card">
            <input type="radio" name="userType" value="host" id="role-host" onchange="toggleRoleFields()">
            <div class="card-inner">
              <div class="icon-wrap host-icon">
                <i class="fa-solid fa-building-columns"></i>
              </div>
              <h3 class="font-heading text-base font-bold text-white">Host / Recruiter</h3>
              <p class="text-xs text-slate-400 mt-1">Post micro-jobs & manage applicants</p>
            </div>
          </label>
        </div>
      </div>

      <!-- Common Name & Email -->
      <div class="bg-slate-900/90 border border-slate-800 p-5 rounded-2xl space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs text-slate-400 mb-1">Full Name *</label>
            <input type="text" name="fullName" value="<%= (typeof user !== 'undefined' && user.firstName) ? (user.firstName + ' ' + (user.lastName || '')) : '' %>" placeholder="e.g. Adarsh Rajput" class="input-field" required>
          </div>
          <div>
            <label class="block text-xs text-slate-400 mb-1">Your Email (Auto-filled) *</label>
            <input type="email" name="universityEmail" value="<%= (typeof user !== 'undefined' && user.email) ? user.email : '' %>" placeholder="e.g. adarsh@gmail.com" class="input-field" required readonly>
          </div>
        </div>
      </div>

