                <option value="A1 - Parul Institute of Engineering & Technology" <%= home.location === "A1 - Parul Institute of Engineering & Technology" ? "selected" : "" %>>A1 - Parul Institute of Engineering & Technology</option>
                <option value="A2 - Parul Institute of Engineering & Technology (Diploma Studies)" <%= home.location === "A2 - Parul Institute of Engineering & Technology (Diploma Studies)" ? "selected" : "" %>>A2 - Parul Institute of Engineering & Technology (Diploma Studies)</option>
                <option value="A3 - Parul Institute of Engineering & Technology (D Block)" <%= home.location === "A3 - Parul Institute of Engineering & Technology (D Block)" ? "selected" : "" %>>A3 - Parul Institute of Engineering & Technology (D Block)</option>
                <option value="A4 - Parul Institute of Pharmacy" <%= home.location === "A4 - Parul Institute of Pharmacy" ? "selected" : "" %>>A4 - Parul Institute of Pharmacy</option>
                <option value="A5 - Parul Institute of Engineering & Tech (Diploma & Gymnasium)" <%= home.location === "A5 - Parul Institute of Engineering & Tech (Diploma & Gymnasium)" ? "selected" : "" %>>A5 - Parul Institute of Engineering & Tech (Diploma & Gymnasium)</option>
                <option value="A6 - Parul Institute of Nursing" <%= home.location === "A6 - Parul Institute of Nursing" ? "selected" : "" %>>A6 - Parul Institute of Nursing</option>
