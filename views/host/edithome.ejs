                <option value="A29 - Parul Institute of Performing Arts" <%= home.location === "A29 - Parul Institute of Performing Arts" ? "selected" : "" %>>A29 - Parul Institute of Performing Arts</option>
              </optgroup>

              <optgroup label="🏢 Administrative Block (C)">
                <option value="C1 - Student Section / Scholarship / Accounts / Central Library" <%= home.location === "C1 - Student Section / Scholarship / Accounts / Central Library" ? "selected" : "" %>>C1 - Student Section / Scholarship / Accounts / Central Library</option>
