                <option value="A8 - Parul Institute of Pharmacy & Research" <%= home.location === "A8 - Parul Institute of Pharmacy & Research" ? "selected" : "" %>>A8 - Parul Institute of Pharmacy & Research</option>
                <option value="A9 - Parul Polytechnic Institute" <%= home.location === "A9 - Parul Polytechnic Institute" ? "selected" : "" %>>A9 - Parul Polytechnic Institute</option>
                <option value="A10 - School of Pharmacy" <%= home.location === "A10 - School of Pharmacy" ? "selected" : "" %>>A10 - School of Pharmacy</option>
