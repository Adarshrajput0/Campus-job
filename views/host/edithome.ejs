                "A1 - Parul Institute of Engineering & Technology", "A2 - Parul Institute of Engineering & Technology (Diploma Studies)", "A3 - Parul Institute of Engineering & Technology (D Block)", "A4 - Parul Institute of Pharmacy", "A5 - Parul Institute of Engineering & Tech (Diploma & Gymnasium)", "A6 - Parul Institute of Nursing", "A7 - JNHMC Homoeopathic College & Physiotherapy", "A8 - Parul Institute of Pharmacy & Research", "A9 - Parul Polytechnic Institute", "A10 - School of Pharmacy", "A11 - Medical Library & Insights-Centre & PIPER", "A12 - Parul Institute of Medical Sciences & Symphony Hall", "A13 - Parul Institute of Ayurved", "A14 - Parul Institute of Business Administration", "A15 - Faculty of Management Studies", "A16 - Parul Institute of Architecture & Physiotherapy Research", "A17 - Parul Institute of Homeopathy & Research", "A18 - Parul Institute of Ayurved & Research", "A19 - Parul Institute of Tech & Hotel Management", "A20 - Vikram Sarabhai Center", "A21 - Parul Institute of Applied Sciences", "A22 - Parul Institute of Design, Fine Arts & Performing Arts", "A23 - Subhash Chandra Bose Bhawan (Law, Commerce, Arts, Agriculture)", "A24 - Bhagat Singh Bhawan (Computer Application & Engineering)", "A25 - C.V. Raman Centre - Center Of Excellence", "A26 - 24 Frames Studio", "A27 - Proposed Library Building", "A28 - Lakshya 2047: Center for Future Skills", "A29 - Parul Institute of Performing Arts",
                "C1 - Student Section / Scholarship / Accounts / Central Library", "C2 - Admission Cell / Placement Cell / IQAC / MIS Cell", "C3 - Centre of International Relations / CEO Office / Alumni", "C4 - HR & Administration / Doctoral Studies / Cultural Affairs", "C5 - Office of Hostel Superintendent & Chief Rector",
                "H1 - Shastri Bhawan - A", "H2 - Shastri Bhawan - B", "H3 - Shastri Bhawan - C", "H4 - Marie Curie Residence", "H5 - Sarojini Bhawan - A", "H6 - Sarojini Bhawan - B", "H7 - Sarojini Bhawan - C", "H8 - Indira Bhawan - A", "H9 - Indira Bhawan - B", "H10 - Indira Bhawan - C", "H11 - Albert Einstein Residence", "H12 - Kalam Bhawan - A", "H13 - Kalam Bhawan - B", "H14 - Kalam Bhawan - C", "H15 - Tagore Bhawan - A", "H16 - Tagore Bhawan - B", "H17 - Dhyan Bhawan", "H18 - Janki Bhawan", "H19 - Teresa Bhawan - A", "H20 - Teresa Bhawan - B", "H21 - Teresa Bhawan - C", "H22 - Teresa Bhawan - D", "H23 - Shakuntala Bhawan - A", "H24 - Shakuntala Bhawan - B", "H25 - Atal Bhawan - A1", "H26 - Atal Bhawan - A2", "H27 - Milkha Bhawan - A", "H28 - Kalpana Bhawan - A", "H29 - Kalpana Bhawan - B", "H30 - Sardar Bhawan - A", "H31 - Sardar Bhawan - B", "H32 - Atal Bhawan - B", "H33 - Azad Bhawan - A", "H34 - Tagore Bhawan - C", "H35 - Rani Laxmibai Bhawan - A", "H36 - Rani Laxmibai Bhawan - B",
                "E1 - Parul Ayurved Hospital", "E2 - Parul Sevashram Hospital", "E3 - Khemdas Ayurved Hospital", "E4 - Parul Institute of Homeopathy Hospital", "E5 - JNHMC Medical College Hospital", "E6 - Proposed Cancer Hospital",
                "B1 - Central Bank of India", "TS - Transport Office / Pick & Drop Point",
                "P1 - Visitor's Parking", "P2 - Staff 2-Wheeler Parking", "P3 - Student 2-Wheeler Parking", "P4 - Bus Parking", "P5 to P8 - Staff 4-Wheeler Parking"
              ].includes(home.location)) { %>
                <option value="<%= home.location %>" selected><%= home.location %></option>
              <% } %>
            </select>
          </div>

          <!-- DESCRIPTION -->
          <div>
            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">
              Task Description
            </label>
            <textarea
              name="description"
              rows="4"
              required
              placeholder="Explain what needs to be done clearly..."
              class="w-full px-4 py-3 border border-slate-200 rounded-2xl bg-white text-slate-900 placeholder-slate-400 focus:outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 transition duration-200 text-sm resize-none"
            ><%= home.description || '' %></textarea>
          </div>

          <!-- FILES UPLOAD (images + PDFs + docs) -->
          <div>
            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">
              Attachments — Images, PDFs, Documents <span class="text-slate-300 font-normal">(up to 10 files · 20 MB each)</span>
            </label>

            <!-- Drop Zone -->
            <div
              id="drop-zone"
              onclick="document.getElementById('file-input').click()"
              class="relative border-2 border-dashed border-slate-200 hover:border-indigo-400 rounded-2xl p-8 text-center cursor-pointer transition-all duration-200 bg-slate-50 hover:bg-indigo-50"
            >
              <input
                id="file-input"
                type="file"
                name="files"
                multiple
                accept="image/*,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.zip,.rar"
                class="hidden"
                onchange="handleFiles(this.files)"
              />
              <div id="drop-placeholder">
                <div class="w-14 h-14 rounded-2xl bg-white border border-slate-200 flex items-center justify-center mx-auto mb-3 shadow-sm">
                  <i class="fa-solid fa-cloud-arrow-up text-2xl text-indigo-400"></i>
                </div>
                <p class="text-sm font-semibold text-slate-600">Click to browse or drag & drop files here</p>
                <p class="text-xs text-slate-400 mt-1">Images, PDFs, Word, Excel, PowerPoint, ZIP — any type</p>
              </div>
            </div>

            <!-- Live Preview Grid -->
            <div id="preview-grid" class="mt-4 grid grid-cols-2 sm:grid-cols-3 gap-3 hidden"></div>

            <!-- Existing files when editing -->
            <% if (editing && home.photos && home.photos.length > 0) { %>
              <div class="mt-4">
                <p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Current Images</p>
                <div class="grid grid-cols-3 sm:grid-cols-4 gap-2">
                  <% home.photos.forEach(p => { %>
                    <div class="relative rounded-xl overflow-hidden h-20 bg-slate-100 border border-slate-200">
                      <img src="<%= p %>" class="w-full h-full object-cover" />
                    </div>
                  <% }) %>
                </div>
              </div>
            <% } %>
            <% if (editing && home.attachments && home.attachments.length > 0) { %>
              <div class="mt-3">
                <p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Current Attachments</p>
                <div class="space-y-1.5">
                  <% home.attachments.forEach(a => { %>
                    <a href="<%= a.url %>" target="_blank" class="flex items-center gap-2 text-xs text-indigo-600 hover:underline bg-indigo-50 border border-indigo-100 rounded-xl px-3 py-2">
                      <i class="fa-solid fa-file-arrow-down text-indigo-400"></i>
                      <%= a.name %>
                    </a>
                  <% }) %>
                </div>
              </div>
            <% } %>
          </div>

          <style>
            #drop-zone.drag-over {
              border-color: #6366f1;
              background: #eef2ff;
            }
            .preview-item {
              position: relative;
              border-radius: 14px;
              overflow: hidden;
              border: 1px solid #e2e8f0;
              background: #f8fafc;
              animation: previewPop 0.2s cubic-bezier(.34,1.56,.64,1) both;
            }
            @keyframes previewPop {
              from { opacity: 0; transform: scale(0.88); }
              to   { opacity: 1; transform: scale(1); }
            }
            .preview-remove {
              position: absolute; top: 4px; right: 4px;
              width: 20px; height: 20px;
              background: rgba(15,23,42,.7);
              color: white;
              border-radius: 50%;
              border: none;
              cursor: pointer;
              font-size: 10px;
              display: flex; align-items: center; justify-content: center;
            }
          </style>

          <script>
            const dropZone = document.getElementById('drop-zone');
            const fileInput = document.getElementById('file-input');
            const previewGrid = document.getElementById('preview-grid');
            let selectedFiles = [];

            // Drag & drop support
            dropZone.addEventListener('dragover', e => { e.preventDefault(); dropZone.classList.add('drag-over'); });
            dropZone.addEventListener('dragleave', () => dropZone.classList.remove('drag-over'));
            dropZone.addEventListener('drop', e => {
              e.preventDefault();
              dropZone.classList.remove('drag-over');
              handleFiles(e.dataTransfer.files);
            });

            function handleFiles(newFiles) {
              const arr = Array.from(newFiles);
              if (selectedFiles.length + arr.length > 10) {
                alert('Maximum 10 files allowed!');
                return;
              }
              selectedFiles = [...selectedFiles, ...arr];
              updateFileInput();
              renderPreviews();
            }

            function updateFileInput() {
              // Rebuild the FileList-like object via DataTransfer
              const dt = new DataTransfer();
              selectedFiles.forEach(f => dt.items.add(f));
              fileInput.files = dt.files;
            }

            function removeFile(index) {
              selectedFiles.splice(index, 1);
              updateFileInput();
              renderPreviews();
            }

            function renderPreviews() {
              previewGrid.innerHTML = '';
              if (selectedFiles.length === 0) {
                previewGrid.classList.add('hidden');
                return;
              }
              previewGrid.classList.remove('hidden');

              selectedFiles.forEach((file, i) => {
                const item = document.createElement('div');
                item.className = 'preview-item';

                const removeBtn = `<button type="button" class="preview-remove" onclick="removeFile(${i})">✕</button>`;

                if (file.type.startsWith('image/')) {
                  const url = URL.createObjectURL(file);
                  item.innerHTML = `
                    <img src="${url}" class="w-full h-24 object-cover" />
                    <p class="text-[10px] text-slate-500 truncate px-2 py-1">${file.name}</p>
                    ${removeBtn}
                  `;
                } else {
                  // File icon for non-images
                  const ext = file.name.split('.').pop().toUpperCase();
                  const iconMap = { PDF: '🔴', DOC: '🔵', DOCX: '🔵', XLS: '🟢', XLSX: '🟢', PPT: '🟠', PPTX: '🟠', ZIP: '🟤', RAR: '🟤' };
                  const icon = iconMap[ext] || '📄';
                  item.innerHTML = `
                    <div class="flex flex-col items-center justify-center h-24 gap-2 px-2">
                      <span class="text-3xl">${icon}</span>
                      <span class="text-[9px] font-bold bg-slate-200 text-slate-600 px-2 py-0.5 rounded-full">${ext}</span>
                    </div>
                    <p class="text-[10px] text-slate-500 truncate px-2 pb-2">${file.name}</p>
                    ${removeBtn}
                  `;
                }
                previewGrid.appendChild(item);
              });
            }
          </script>

          <!-- SUBMIT -->
          <div class="pt-6">
            <button
              type="submit"
              style="background-color: #4f46e5 !important; color: #ffffff !important; display: flex; align-items: center; justify-content: center; gap: 10px;"
              class="w-full py-4 px-6 rounded-2xl font-heading text-base font-extrabold uppercase tracking-wider shadow-lg hover:bg-indigo-700 transition duration-200 cursor-pointer border border-indigo-600"
            >
              <i class="fa-solid fa-paper-plane text-white text-base"></i>
              <span><%= editing ? "Update Task Details" : "Post Task Now" %></span>
            </button>
          </div>

        </form>
      </div>
    </main>

    <%- include('../partials/chatbot-widget') %>

  </body>
</html>