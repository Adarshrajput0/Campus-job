<% 
  let isSaved = false;
  if (typeof user !== 'undefined' && user && user.favourites && Array.isArray(user.favourites)) {
    isSaved = user.favourites.some(fav => {
      const favId = fav._id ? fav._id.toString() : fav.toString();
      return favId === home._id.toString();
    });
  }
%>

<% if (isSaved) { %>
  <form action="/favourites/delete/<%= home._id %>" method="POST" class="flex justify-center w-full">
    <button
      type="submit"
      class="group flex items-center justify-center gap-2 w-full px-5 py-2.5 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800 text-emerald-600 dark:text-emerald-400 font-heading font-bold text-xs shadow-sm hover:bg-rose-50 hover:border-rose-200 hover:text-rose-600 transition-all duration-200"
    >
      <i class="fa-solid fa-bookmark text-emerald-500 group-hover:text-rose-500"></i>
      Saved Task
    </button>
  </form>
<% } else { %>
  <form action="/favourites" method="POST" class="flex justify-center w-full">
    <input type="hidden" name="id" value="<%= home._id %>" />
    <button
      type="submit"
      class="group flex items-center justify-center gap-2 w-full px-5 py-2.5 rounded-xl bg-indigo-600 text-white font-heading font-bold text-xs shadow-sm hover:bg-indigo-700 hover:shadow-md transition-all duration-200"
    >
      <i class="fa-regular fa-bookmark group-hover:scale-110 transition"></i>
      Save Task
    </button>
  </form>
<% } %>

